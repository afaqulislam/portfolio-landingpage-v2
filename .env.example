# Copy this file to .env and fill in your values.

# Resend API key — create one at https://resend.com/api-keys
# Note: onboarding@resend.dev can only send to your own verified email.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where the contact form messages get delivered (defaults to afaqulislam707@gmail.com)
CONTACT_TO=you@example.com

# Sender shown in the delivered email (must be a verified Resend sender/domain)
RESEND_FROM="Afaq Ul Islam <onboarding@resend.dev>"

# Optional — canonical site URL used for metadata, Open Graph and the contact
# form's origin check. On Vercel this is detected automatically.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
